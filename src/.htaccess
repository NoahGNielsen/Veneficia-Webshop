Options -Indexes

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ==============================================================================
# CUSTOM ERROR PAGES
# Local paths only (a full URL would turn the error into a 302 redirect, and
# Apache rejects it outright for 401). Each page sets its own status code.
# ==============================================================================
ErrorDocument 400 /assets/php/statusCodesPages/400.php
ErrorDocument 401 /assets/php/statusCodesPages/401.php
ErrorDocument 403 /assets/php/statusCodesPages/403.php
ErrorDocument 404 /assets/php/statusCodesPages/404.php
ErrorDocument 410 /assets/php/statusCodesPages/410.php
ErrorDocument 423 /assets/php/statusCodesPages/423.php
ErrorDocument 500 /assets/php/statusCodesPages/500.php
ErrorDocument 502 /assets/php/statusCodesPages/502.php
ErrorDocument 503 /assets/php/statusCodesPages/503.php
ErrorDocument 504 /assets/php/statusCodesPages/504.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep certificate-validation files reachable, but block other dotfiles.
    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

    # Block common backup, configuration, and log files.
    RewriteRule \.(?:bak|config|sql|ini|log|sh|inc|swp|dist|env|ya?ml)$ - [F,NC,L]

    # The category sitemap is built from the database
    RewriteRule ^sitemap-categories\.xml$ sitemapCategories.php [L]

    # Redirect direct extension URLs to their clean versions for page requests.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.(?:html?|php)(?:[?\s]) [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Serve existing pages without requiring their file extensions in the URL.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.htm -f
    RewriteRule ^(.+?)/?$ $1.htm [L]

    # Product pages: /category/product-name-5 is product.php?id=5 (product.php redirects other spellings to the real
    # one). The visitor's own query string is dropped, so it can't override the id.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^[a-z0-9-]+/[a-z0-9-]+-([0-9]{1,19})/?$ product.php?id=$1 [NC,L]

    # Category pages: /category-name is products.php, which reads the category from the path (not the query string,
    # so ?tag= and ?page= still work and can't change the category) and 404s for names that aren't a category.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^[a-z0-9-]{1,80}/?$ products.php [NC,L]
</IfModule>
